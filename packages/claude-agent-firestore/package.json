{
  "name": "claude-agent-firestore",
  "version": "0.0.4",
  "description": "Firestore-backed SessionStore for the Claude Agent SDK",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wakita181009/claude-agent-firestore.git",
    "directory": "packages/claude-agent-firestore"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0",
    "@google-cloud/firestore": ">=7.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@google-cloud/firestore": "^8.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
